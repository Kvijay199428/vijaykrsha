# Documents and assets share these cache rules; the CSP below applies to every
# route via the catch-all.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com wss://vega-api.vijaykrsha.online; frame-src 'self' https://challenges.cloudflare.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/vega/*
  Cache-Control: no-store
# Favicon, icon, and manifest files — stable but not content-hashed,
# so use a moderate cache lifetime with revalidation.
/favicon.*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/site.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/*
  Cache-Control: public, max-age=31536000, immutable
